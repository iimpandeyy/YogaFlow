# YogaFlow environment variables — NAMES ONLY. Never put real values in this file.
# Copy to .env.local (ignored by git) and fill in locally, or set them in Vercel for deploys.
# Only the Supabase project URL and the PUBLIC anonymous key are used.
# Never add a service-role key. Unit/component tests and the build do not need these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
